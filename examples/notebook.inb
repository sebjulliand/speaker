{"cells":[{"cell_type":"markdown","metadata":{},"source":"# Display library list"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["cl"]},"outputs":[],"source":"DSPLIBL"},{"cell_type":"markdown","metadata":{},"source":"# Run shell command"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["shellscript"]},"outputs":[],"source":"java -version"},{"cell_type":"markdown","metadata":{},"source":"# List the 10 biggest object in QGPL"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["sql"]},"outputs":[],"source":"Select * From table(qsys2.object_statistics('QGPL', '*ALL')) Order by objsize desc limit 10"},{"cell_type":"markdown","metadata":{},"source":"# Fetch a dad joke"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["sql"]},"outputs":[],"source":"select json_value(response_message, '$.joke' returning varchar(5000)) as joke from table ( qsys2.http_get_verbose('https://icanhazdadjoke.com', json_object('sslTolerate':'true', 'headers': json_object('accept': 'application/json' ))));"},{"cell_type":"markdown","metadata":{},"source":"# Objects count by types"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["sql"]},"outputs":[],"source":"-- chart: pie\n-- title: MEDIOZ objects count\n-- y: Kilobytes\n-- hideStatement: true\nSelect objtype || ' (' || count(objtype) || ')' as label, count(objtype) as \"Count\" FROM TABLE(QSYS2.OBJECT_STATISTICS('QGPL', '*ALL')) Group By objtype Order by \"Count\" Desc"},{"cell_type":"markdown","metadata":{},"source":"# Ten biggest IFS files in /tmp"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["sql"]},"outputs":[],"source":"-- chart: bar\r\n-- title: /tmp 10 biggest files\r\n-- y: Kilobytes\r\n-- hideStatement: true\r\nSelect replace(path_name, '/tmp/', '') as \"label\", data_size as \"size\" from table(Qsys2.ifs_object_statistics(start_path_name => '/tmp')) order by data_size desc limit 10"},{"cell_type":"markdown","metadata":{},"source":"# Number of open connections per TCP ports"},{"cell_type":"code","execution_count":null,"metadata":{"tags":["sql"]},"outputs":[],"source":"-- chart: line\r\n-- title: open connections per ports\r\n-- y: connections\r\n-- hideStatement: true\r\nselect local_port || ' (' || Coalesce(LOCAL_PORT_NAME, '?') || ')' as \"label\", count(*) as \"connections\" from qsys2.netstat_info where remote_address not in('0.0.0.0', '::') Group by local_port, LOCAL_PORT_NAME Order by 2 desc limit 10"}],"metadata":{"kernelspec":{"display_name":"DB2 for IBM i","name":"db2i"},"language_info":{"name":"sql","file_extension":"sql"}},"nbformat":4,"nbformat_minor":0}